# Git-Bulk Credentials Configuration File
# =======================================
#
# This file demonstrates both global and server-specific credential configuration.
# Save this as ~/.config/git-bulk/credentials or use --credentials-file flag.

# Global credentials (used as fallback for any server)
# ====================================================
GITHUB_TOKEN="ghp_your_global_github_token_here"
GITHUB_USERNAME="your_global_github_username"
GITLAB_TOKEN="glpat-your_global_gitlab_token_here"
GITLAB_USERNAME="your_global_gitlab_username"
GERRIT_USERNAME="your_global_gerrit_username"
GERRIT_PASSWORD="your_global_gerrit_password"
GERRIT_TOKEN="your_global_gerrit_token"

# Server-Specific Credentials
# ============================
# Use INI-style sections [hostname] to configure credentials for specific servers.
# The tool will automatically extract the hostname from your source and use
# matching server-specific credentials when available.

# ONAP Gerrit Server
[gerrit.onap.org]
USERNAME="your_onap_username"
TOKEN="your_onap_gerrit_token_here"
# PASSWORD="your_onap_password"  # Optional if using TOKEN

# O-RAN SC Gerrit Server
[gerrit.o-ran-sc.org]
USERNAME="your_oran_username"
TOKEN="your_oran_gerrit_token_here"

# Linux Foundation Gerrit
[gerrit.linuxfoundation.org]
USERNAME="your_lf_username"
TOKEN="your_lf_gerrit_token"

# Company Internal Gerrit
[gerrit.company.com]
USERNAME="your_company_username"
PASSWORD="your_company_gerrit_password"
TOKEN="your_company_gerrit_token"

# Enterprise GitLab Instance
[gitlab.company.com]
USERNAME="your_company_gitlab_user"
TOKEN="your_company_gitlab_token"

# Enterprise GitHub Instance
[github.enterprise.com]
USERNAME="your_enterprise_github_user"
TOKEN="your_enterprise_github_token"

# Additional Examples
# ===================

# Academic Institution Gerrit
[gerrit.university.edu]
USERNAME="student_id_or_username"
TOKEN="university_gerrit_token"

# Government Gerrit Instance
[gerrit.government.gov]
USERNAME="your_gov_username"
TOKEN="your_gov_token"

# Open Source Project GitLab
[gitlab.opensource-project.org]
USERNAME="your_oss_username"
TOKEN="your_oss_gitlab_token"

# Configuration Notes
# ===================
#
# 1. Credential Priority (highest to lowest):
#    - Environment variables (GITHUB_TOKEN, GERRIT_TOKEN, etc.)
#    - Server-specific credentials ([hostname] sections)
#    - Global credentials (top-level variables)
#
# 2. Supported keys in server sections:
#    - USERNAME, PASSWORD, TOKEN (generic for any provider)
#    - GITHUB_USERNAME, GITHUB_TOKEN (GitHub-specific)
#    - GITLAB_USERNAME, GITLAB_TOKEN (GitLab-specific)
#    - GERRIT_USERNAME, GERRIT_PASSWORD, GERRIT_TOKEN (Gerrit-specific)
#
# 3. Server hostname matching:
#    - gerrit.onap.org → [gerrit.onap.org]
#    - https://gitlab.company.com/group → [gitlab.company.com]
#    - ssh://user@gerrit.example.com:29418/repo → [gerrit.example.com]
#
# 4. For Gerrit servers, TOKEN takes priority over PASSWORD when both are available
#
# 5. Comments start with # and blank lines are ignored
#
# 6. Values can be quoted with single or double quotes (optional)
#
# Examples of tool usage with server-specific credentials:
#
# git-bulk clone gerrit.onap.org                    # Uses [gerrit.onap.org] credentials
# git-bulk clone gerrit.o-ran-sc.org               # Uses [gerrit.o-ran-sc.org] credentials
# git-bulk clone gitlab.company.com/group          # Uses [gitlab.company.com] credentials
# git-bulk clone gerrit.unknown.com                # Falls back to global credentials